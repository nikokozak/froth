{
  "name": "froth",
  "displayName": "Froth",
  "description": "Live board control for Froth devices",
  "version": "0.1.1",
  "publisher": "NikolaiKozak",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikokozak/froth.git"
  },
  "homepage": "https://frothlang.org",
  "bugs": {
    "url": "https://github.com/nikokozak/froth/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "files": [
    "out/cli-discovery.js",
    "out/controller.js",
    "out/control-session-client.js",
    "out/extension.js",
    "out/runtime-forms.js",
    "out/send-file.js",
    "out/send-file-reset.js",
    "out/vscode-host.js",
    "syntaxes/**",
    "language-configuration.json",
    "README.md",
    "LICENSE"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:froth"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "froth",
        "extensions": [
          ".froth"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "froth",
        "scopeName": "source.froth",
        "path": "./syntaxes/froth.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "froth.connect",
        "title": "Froth: Connect Device",
        "icon": "$(plug)"
      },
      {
        "command": "froth.forceReconnect",
        "title": "Froth: Force Reconnect",
        "icon": "$(debug-restart)"
      },
      {
        "command": "froth.disconnect",
        "title": "Froth: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "froth.sendSelection",
        "title": "Froth: Send Selection / Form",
        "icon": "$(play)"
      },
      {
        "command": "froth.runBinding",
        "title": "Froth: Run Binding",
        "icon": "$(run)"
      },
      {
        "command": "froth.pinRunBinding",
        "title": "Froth: Pin Run Binding",
        "icon": "$(pinned)"
      },
      {
        "command": "froth.runLast",
        "title": "Froth: Rerun Last Form",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "froth.runPinned",
        "title": "Froth: Run Pinned Binding",
        "icon": "$(debug-start)"
      },
      {
        "command": "froth.sendFile",
        "title": "Froth: Send File",
        "icon": "$(file-code)"
      },
      {
        "command": "froth.interrupt",
        "title": "Froth: Interrupt",
        "icon": "$(debug-stop)"
      },
      {
        "command": "froth.words",
        "title": "Froth: Words",
        "icon": "$(list-unordered)"
      },
      {
        "command": "froth.see",
        "title": "Froth: See Binding",
        "icon": "$(symbol-field)"
      },
      {
        "command": "froth.core",
        "title": "Froth: Show Core Binding",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "froth.slotInfo",
        "title": "Froth: Show Slot Info",
        "icon": "$(info)"
      },
      {
        "command": "froth.save",
        "title": "Froth: Save Snapshot",
        "icon": "$(save)"
      },
      {
        "command": "froth.restore",
        "title": "Froth: Restore Snapshot",
        "icon": "$(history)"
      },
      {
        "command": "froth.wipe",
        "title": "Froth: Dangerous Wipe Snapshot",
        "icon": "$(trash)"
      },
      {
        "command": "froth.doctor",
        "title": "Froth: Run Doctor",
        "icon": "$(tools)"
      },
      {
        "command": "froth.showConsole",
        "title": "Froth: Show Console",
        "icon": "$(terminal)"
      }
    ],
    "keybindings": [
      {
        "command": "froth.sendSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (resourceExtname == .froth)"
      },
      {
        "command": "froth.runLast",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "froth.hasLastRun && editorTextFocus && (resourceExtname == .froth)"
      },
      {
        "command": "froth.pinRunBinding",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && (resourceExtname == .froth)"
      },
      {
        "command": "froth.runPinned",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "froth.hasPinnedRun && editorTextFocus && (resourceExtname == .froth)"
      },
      {
        "command": "froth.sendFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && (resourceExtname == .froth)"
      },
      {
        "command": "froth.see",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus && (resourceExtname == .froth)"
      },
      {
        "command": "froth.interrupt",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "froth.isRunning"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "froth",
          "title": "Froth",
          "icon": "$(symbol-misc)"
        }
      ]
    },
    "views": {
      "froth": [
        {
          "id": "frothDeviceView",
          "name": "Device"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "frothDeviceView",
        "contents": "Connect to a Froth device from the current VS Code window.\n\n[Connect Device](command:froth.connect)\n[Show Console](command:froth.showConsole)\n[Run Doctor](command:froth.doctor)"
      }
    ],
    "configuration": {
      "title": "Froth",
      "properties": {
        "froth.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the installed `froth` CLI binary. Leave empty to auto-discover `froth` on PATH."
        },
        "froth.port": {
          "type": "string",
          "default": "",
          "description": "Preferred serial port for Froth device connections. Leave empty to auto-connect one device or prompt when several are found."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "froth.connect",
          "when": "view == frothDeviceView",
          "group": "navigation"
        },
        {
          "command": "froth.forceReconnect",
          "when": "view == frothDeviceView",
          "group": "navigation"
        },
        {
          "command": "froth.disconnect",
          "when": "view == frothDeviceView",
          "group": "navigation"
        },
        {
          "command": "froth.interrupt",
          "when": "view == frothDeviceView",
          "group": "navigation"
        },
        {
          "command": "froth.runLast",
          "when": "view == frothDeviceView && froth.hasLastRun",
          "group": "navigation"
        },
        {
          "command": "froth.runPinned",
          "when": "view == frothDeviceView && froth.hasPinnedRun",
          "group": "navigation"
        },
        {
          "command": "froth.pinRunBinding",
          "when": "view == frothDeviceView",
          "group": "navigation"
        },
        {
          "command": "froth.showConsole",
          "when": "view == frothDeviceView",
          "group": "navigation"
        },
        {
          "command": "froth.words",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.see",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.core",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.slotInfo",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.save",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.restore",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.wipe",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        },
        {
          "command": "froth.doctor",
          "when": "view == frothDeviceView",
          "group": "2_actions"
        }
      ],
      "editor/title": [
        {
          "command": "froth.sendSelection",
          "when": "resourceExtname == .froth",
          "group": "navigation"
        },
        {
          "command": "froth.runBinding",
          "when": "resourceExtname == .froth",
          "group": "navigation"
        },
        {
          "command": "froth.pinRunBinding",
          "when": "resourceExtname == .froth",
          "group": "navigation"
        },
        {
          "command": "froth.runLast",
          "when": "froth.hasLastRun && (resourceExtname == .froth)",
          "group": "navigation"
        },
        {
          "command": "froth.runPinned",
          "when": "froth.hasPinnedRun && (resourceExtname == .froth)",
          "group": "navigation"
        },
        {
          "command": "froth.sendFile",
          "when": "resourceExtname == .froth",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package:vsix": "npm run compile && vsce package --no-yarn",
    "test:package": "npm run compile && node test/package-smoke.js",
    "watch": "tsc -watch -p ./",
    "test:smoke": "node test/control-session-smoke.js && node test/runtime-forms-smoke.js && node test/controller-smoke.js && node test/extension-smoke.js",
    "test:extension-host": "node test/run-extension-host-smoke.js",
    "test": "npm run compile && npm run test:smoke"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.0"
  }
}
